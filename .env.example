# ==============================================================================
# Environment Configuration Template for AI-Meeting-Assistant
# Copy this file to .env and replace placeholders with real values.
# DO NOT COMMIT THE ACTUAL .env FILE!
# ==============================================================================

# Authentication secret for signing JWT tokens (generate a strong random secret)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Google Gemini API key for meeting summaries and action items extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL:
# Default SQLite: sqlite:///./database.db
# Optional PostgreSQL: postgresql://meeting_user:meeting_pass@localhost:5432/meeting_assistant
DATABASE_URL=sqlite:///./database.db

# Application Port
PORT=8000
