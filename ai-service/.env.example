# FFmpeg Configuration for AI Service
# Specify the absolute path to your ffmpeg.exe or the directory containing ffmpeg.exe
# Example Windows path:
# FFMPEG_PATH=C:\path\to\ffmpeg\bin\ffmpeg.exe

FFMPEG_PATH=

# Google Gemini API Configuration for AI Service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Database Configuration (Neon Cloud PostgreSQL)
# Example: DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=
