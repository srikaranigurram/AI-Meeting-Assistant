# AI Meeting Assistant - Root Backend & AI Service Environment Configuration

# Neon Cloud PostgreSQL Database Connection
# Example: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT=30.0

# FFmpeg Executable or Directory Path (Required by local Whisper)
FFMPEG_PATH=

# JWT Authentication Secret
JWT_SECRET_KEY=your_jwt_secret_key_here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend Server Port
PORT=8000
